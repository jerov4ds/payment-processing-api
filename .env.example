NODE_ENV=development
HOST=0.0.0.0
PORT=4317
LOG_LEVEL=info

# clientId:secret pairs, comma-separated. Secrets are hashed at startup.
API_KEYS=demo:dev-api-key-change-me

# json | postgres | memory
REPOSITORY_DRIVER=json
JSON_STORE_PATH=./data/payments.json
DATABASE_URL=postgres://payments:payments@localhost:54329/payments
AUTO_MIGRATE=true

CORS_ORIGINS=http://localhost:4317
BODY_LIMIT_BYTES=16384
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

GATEWAY_MIN_LATENCY_MS=20
GATEWAY_MAX_LATENCY_MS=50
GATEWAY_TIMEOUT_MS=2000
GATEWAY_TRANSIENT_FAILURE_RATE=0
GATEWAY_PERMANENT_FAILURE_RATE=0
GATEWAY_SEED=1

PAYMENT_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=50
RETRY_MAX_DELAY_MS=2000
WORKER_CONCURRENCY=5
SHUTDOWN_DRAIN_MS=10000
PROCESSING_LEASE_MS=5000
RECONCILE_INTERVAL_MS=1000

PROBLEM_BASE_URI=https://payment-service.local/problems
